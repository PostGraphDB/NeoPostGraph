-- OR logic check
SELECT NeoPostGraph.get_or_vlabel_ids('label_graph', ARRAY['engineer', 'software']::text[]);
 get_or_vlabel_ids 
-------------------
                 3
                 6
                 7
(3 rows)


SELECT NeoPostGraph.get_or_vlabel_ids('label_graph', ARRAY['employee', 'software']::text[]);
