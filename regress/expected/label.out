LOAD 'neopostgraph';


-- Setup the graph
SELECT NeoPostGraph.create_graph('label_graph', 'public');
NOTICE:  graph "label_graph" has been created
 create_graph 
--------------
 
(1 row)


-- Standard labels
SELECT NeoPostGraph.create_vlabel('label_graph', 'person');
NOTICE:  vlabel "person" has been created
 create_vlabel 
---------------
 
(1 row)

SELECT NeoPostGraph.create_vlabel('label_graph', 'software');
NOTICE:  vlabel "software" has been created
 create_vlabel 
---------------
 
(1 row)


-- Creating Label Trees
SELECT NeoPostGraph.create_vlabel('label_graph', 'employee');
NOTICE:  vlabel "employee" has been created
 create_vlabel 
---------------
 
(1 row)

SELECT NeoPostGraph.merge_vlabels('label_graph', 2, 4);
NOTICE:  Merged vlabel "_.person.employee" has been created
 merge_vlabels 
---------------
 
(1 row)

SELECT NeoPostGraph.create_vlabel('label_graph', 'engineer');
NOTICE:  vlabel "engineer" has been created
 create_vlabel 
---------------
 
(1 row)

SELECT NeoPostGraph.merge_vlabels('label_graph', 5, 6);
NOTICE:  Merged vlabel "_.person.employee.engineer" has been created
 merge_vlabels 
---------------
 
(1 row)

SELECT NeoPostGraph.create_vlabel('label_graph', 'contractor');
NOTICE:  vlabel "contractor" has been created
 create_vlabel 
---------------
 
(1 row)

SELECT NeoPostGraph.merge_vlabels('label_graph', 2, 8);
NOTICE:  Merged vlabel "_.person.contractor" has been created
 merge_vlabels 
---------------
 
(1 row)


SELECT NeoPostGraph.create_graph('edge_case_graph', 'public');
NOTICE:  graph "edge_case_graph" has been created
 create_graph 
--------------
 
(1 row)


-- Testing the "_" naming logic
SELECT NeoPostGraph.create_vlabel('edge_case_graph', '_internal');
NOTICE:  vlabel "_internal" has been created
 create_vlabel 
---------------
 
(1 row)

SELECT NeoPostGraph.create_vlabel('edge_case_graph', 'test_label_123');
NOTICE:  vlabel "test_label_123" has been created
 create_vlabel 
---------------
 
(1 row)


