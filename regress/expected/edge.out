--
-- Multi-Label Edge DDL & Migration Tests
--
-- 1. Setup: Create a vertex label
SELECT create_vlabel('edge_graph', 'node');
NOTICE:  vlabel "node" has been created
 create_vlabel 
---------------
 
(1 row)

-- Insert Vertices explicitly using nextval
SELECT insert_vertex(vertex_build(nextval('np_vertex_id_seq_31_2')::int8, 31, 2, 0::smallint, '{}'::gtype));
 insert_vertex 
---------------
 
(1 row)

SELECT insert_vertex(vertex_build(nextval('np_vertex_id_seq_31_2')::int8, 31, 2, 0::smallint, '{}'::gtype));
 insert_vertex 
---------------
 
(1 row)

-- 2. Setup: Base edge labels (These become 4 and 5)
SELECT create_elabel('edge_graph', 'colleague');
NOTICE:  elabel "edge_graph" has been created
 create_elabel 
---------------
 
(1 row)

SELECT create_elabel('edge_graph', 'manager');
NOTICE:  elabel "edge_graph" has been created
 create_elabel 
---------------
 
(1 row)

-- 3. Test: merge_elabels (Manual LTREE path concatenation)
SELECT merge_elabels('edge_graph', 4, 5);
NOTICE:  Merged elabels 4 and 5 for graph "edge_graph"
 merge_elabels 
---------------
 
(1 row)

-- Verify the merged label exists in the catalog
SELECT id, ltree FROM np_edge_label_31 WHERE ltree = '_.colleague.manager'::ltree;
 id | ltree 
----+-------
(0 rows)

-- 4. Setup: Insert edge 1 between Vertex 1 and Vertex 2
SELECT insert_edge(
    vertex_build(1::int8, 31, 2, 0::smallint, '{}'::gtype),
    vertex_build(2::int8, 31, 2, 0::smallint, '{}'::gtype),
    edge_build(nextval('np_edge_id_seq_31_4')::int8, 31, 4, 0::smallint, 
        vertex_build(1::int8, 31, 2, 0::smallint, '{}'::gtype),
        vertex_build(2::int8, 31, 2, 0::smallint, '{}'::gtype),
        '{"department": "engineering"}'::gtype
    )
);
 insert_edge 
-------------
 
(1 row)

SELECT * FROM np_edge_31_4;
 id |                                                           edge                                                            
----+---------------------------------------------------------------------------------------------------------------------------
  1 | {"id": 1, "start_vertex": (2,1), "edge_vertex": (2,2), "label": "colleague", "properties": {"department": "engineering"}}
(1 row)

-- 5. Test: set_edge_label (The Migration Engine)
SELECT set_edge_label(1::int8, 4, 31, 'promoted'::text);
                                                           set_edge_label                                                           
------------------------------------------------------------------------------------------------------------------------------------
 {"id": 1, "start_vertex": (2,1), "edge_vertex": (2,2), "label": "colleague.promoted", "properties": {"department": "engineering"}}
(1 row)

-- Verify the new label was auto-generated by the migrator
SELECT id, ltree FROM np_edge_label_31 WHERE ltree = '_.colleague.promoted'::ltree;
 id |        ltree         
----+----------------------
  8 | _.colleague.promoted
(1 row)

-- 6. Test: remove_edge_label
-- Downgrades Edge 1 from '_.colleague.promoted' (ID 8) back to '_.colleague' (ID 4)
SELECT remove_edge_label(1::int8, 8, 31, 'promoted'::text);
                                                     remove_edge_label                                                     
---------------------------------------------------------------------------------------------------------------------------
 {"id": 1, "start_vertex": (2,1), "edge_vertex": (2,2), "label": "colleague", "properties": {"department": "engineering"}}
(1 row)

-- Verify it properly migrated back to the original table
SELECT * FROM np_edge_31_4 WHERE id = 1;
 id |                                                           edge                                                            
----+---------------------------------------------------------------------------------------------------------------------------
  1 | {"id": 1, "start_vertex": (2,1), "edge_vertex": (2,2), "label": "colleague", "properties": {"department": "engineering"}}
(1 row)

--
-- Edge Annotations Tests
--
-- 1. Create a new edge label equipped with an annotation schema
SELECT create_elabel('edge_graph', 'friend', 'public', ARRAY['close', 'distant']);
NOTICE:  elabel "edge_graph" has been created
 create_elabel 
---------------
 
(1 row)

-- 2. Insert a new edge (Edge ID 2, Label ID 9) between Vertex 1 and 2
SELECT insert_edge(
    vertex_build(1::int8, 31, 2, 0::smallint, '{}'::gtype),
    vertex_build(2::int8, 31, 2, 0::smallint, '{}'::gtype),
    edge_build(2::int8, 31, 9, 0::smallint, 
        vertex_build(1::int8, 31, 2, 0::smallint, '{}'::gtype),
        vertex_build(2::int8, 31, 2, 0::smallint, '{}'::gtype),
        '{"met": "college"}'::gtype
    )
);
 insert_edge 
-------------
 
(1 row)

-- 3. Initial State: Output should show base label "friend"
SELECT * FROM np_edge_31_9 WHERE id = 2;
 id |                                                    edge                                                     
----+-------------------------------------------------------------------------------------------------------------
  2 | {"id": 2, "start_vertex": (2,1), "edge_vertex": (2,2), "label": "friend", "properties": {"met": "college"}}
(1 row)

-- 4. Mutation: Add the 'close' annotation
SELECT add_edge_annotation(2::int8, 9, 31, 'close');
 add_edge_annotation 
---------------------
 
(1 row)

-- 4a. Prove Binary State: Entity Store should hold the updated bitset
SELECT id, annotations FROM np_edge_annotations_31_9 WHERE id = 2;
 id | annotations 
----+-------------
  2 | \x01
(1 row)

-- 4b. Prove String State: edge_out should dynamically append ":close"
SELECT * FROM np_edge_31_9 WHERE id = 2;
 id |                                                       edge                                                        
----+-------------------------------------------------------------------------------------------------------------------
  2 | {"id": 2, "start_vertex": (2,1), "edge_vertex": (2,2), "label": "friend:close", "properties": {"met": "college"}}
(1 row)

-- 5. Teardown: Remove the 'close' annotation
SELECT remove_edge_annotation(2::int8, 9, 31, 'close');
 remove_edge_annotation 
------------------------
 
(1 row)

-- 5a. Prove Binary State: Entity Store bitset should revert
SELECT id, annotations FROM np_edge_annotations_31_9 WHERE id = 2;
 id | annotations 
----+-------------
  2 | \x00
(1 row)

-- 5b. Prove String State: edge_out should revert to base label "friend"
SELECT * FROM np_edge_31_9 WHERE id = 2;
 id |                                                    edge                                                     
----+-------------------------------------------------------------------------------------------------------------
  2 | {"id": 2, "start_vertex": (2,1), "edge_vertex": (2,2), "label": "friend", "properties": {"met": "college"}}
(1 row)

