-- We should see multiple arraylist blocks for owner_id = 1, packed to the absolute brim.
SELECT ctid, id, prev_itemptr, next_itemptr, octet_length(adj_list::text) AS payload_size
FROM np_vertex_21_2_arraylist 
WHERE id = 1
ORDER BY ctid;
